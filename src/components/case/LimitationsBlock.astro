---
interface Props { items: readonly string[] }
const { items } = Astro.props;
---
<section id="limitations" class="limitations-block" aria-labelledby="limitations-title">
  <p class="section-kicker">07 / LIMITATIONS</p>
  <h2 id="limitations-title">Limitations</h2>
  <ol>
    {items.map((item, index) => (
      <li>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <p>{item}</p>
      </li>
    ))}
  </ol>
</section>
