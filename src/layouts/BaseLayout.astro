---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "João Paulo Fortes — Software Developer",
  description = "Software developer focused on backend systems, automation, applied AI and data. Evidence-first portfolio with engineering decisions, tests, trade-offs and limitations.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0F14" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
